---
import Layout from '../components/Layout.astro';
---
<Layout>

    <div class="content">
            <div class="card wecome-card">
                <h2>Select a Company</h2>
                <p>Click on any company below to calculate Production cost.</p>
            </div>

            <div class="card">
                <div class="cards-grid">

                    <div class="company-card" onclick="location.href='/coffeeshop'">Milk And Coffee Shop</div>
                    <div class="company-card" onclick="location.href='/coffeeplantation'">coffee plantation</div>
                    <div class="company-card" onclick="location.href='/cerealfarm'">Cereal Farm</div>
                     <div class="company-card" onclick="location.href='/bakery'">Bakery</div>
                    <div class="company-card" onclick="location.href='/cottonplantation'">Cotton Plantation</div>
                    <div class="company-card" onclick="location.href='/herbsplantation'">Herbs Plantation</div>
               <div class="company-card" onclick="location.href='/weapons'">weapons Factory</div>
               
                </div>
            </div>
        </div>

</Layout>
