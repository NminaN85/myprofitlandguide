                <p>Choose a category to explore the companies related to that skill.</p>
            </div>

            <div class="card">
                <div class="cards-grid">

                   <div class="company-card gathering" onclick="location.href='/gathering'">🌾 Gathering</div>
<div class="company-card handworking" onclick="location.href='/handworking'">🛠 Hand Working</div>
<div class="company-card guestservicing" onclick="location.href='/guestservicing'">☕ Guest Servicing</div>
<div class="company-card engineering" onclick="location.href='/engineering'">⚙ Engineering</div>
<div class="company-card writingaesthetics" onclick="location.href='/writingaestgetics'">✍ Writing & Aesthetics</div>
<div class="company-card extraction" onclick="location.href='/extraction'">⛏ Extraction</div>

                </div>
            </div>
        </div>

</Layout>