---
import Layout from '../components/Layout.astro';
---
<Layout>
<main class="content">

<div class="card">
  <div class="card wecome-card">
    <h2><span class="gold-text">Damage </span>  Calculator</h2>
    <p class="subtitle">
      Calculate how many Mocaccino and total cost are needed to reach your target damage.
    </p>
  </div>

  <!-- INPUTS -->
  <div class="inputs-grid">
    <div class="input-group">
      <label for="weaponPrice">Weapon Price</label>
      <input id="weaponPrice" type="number" placeholder="Weapon Price">
    </div>

    <div class="input-group">
      <label for="mochaPrice">Mocaccino Price</label>
      <input id="mochaPrice" type="number" placeholder="Mocaccino Price">
    </div>

    <div class="input-group">
      <label for="orgBoost">Organisation Boost %</label>
      <input id="orgBoost" type="number" placeholder="Organisation %">
    </div>

    <div class="input-group">
      <label for="poiRegion">POI Region %</label>
      <input id="poiRegion" type="number" placeholder="Region Bonus %">
    </div>

    <div class="input-group">
      <label for="rank">Military Rank</label>
      <select id="rank">
        <option value="1">No Rank</option>
        <option value="1.05">Private (5%)</option>
        <option value="1.10">Corporal (10%)</option>
        <option value="1.15">Sergeant (15%)</option>
        <option value="1.20">Lieutenant (20%)</option>
        <option value="1.25">Captain (25%)</option>
        <option value="1.30">Major (30%)</option>
        <option value="1.35">Colonel (35%)</option>
        <option value="1.40">General (40%)</option>
      </select>
    </div>

<div class="input-group">
      <label for="targetDamage">Target Damage</label>
      <select id="targetDamage">
        <option value="20000">20,000</option>
        <option value="40000">40,000</option>
        <option value="90000">90,000</option>
        <option value="150000">150,000</option>
        <option value="300000">300,000</option>
        <option value="600000">600,000</option>
        <option value="1000000">1,000,000</option>
        <option value="1500000">1,500,000</option>
      </select>
    </div>

    <div class="input-group check">
      <label><input type="checkbox" id="bunker"> Enemy in Bunker</label>
    </div>

    <div class="input-group check">
      <label><input type="checkbox" id="clothing"> Full Clothes</label>
    </div>

    <div class="input-group check">
      <label><input type="checkbox" id="native"> Native Region</label>
    </div>

    <div class="input-group check">
      <label><input type="checkbox" id="badge"> NK Badge</label>
    </div>

    
  </div>

  <!-- BUTTON -->
  <div class="card center-button">
    <button id="mocaccinoCalcBtn" class="button">Calculate Mocaccino</button>
  </div>

  <!-- RESULT -->
  <div class="card">
    <div class="result">
      <h3 class="gold-text">Result</h3>
      <p id="mocaccinoResultText">Your damage breakdown will appear here.</p>
    </div>
  </div>
</div>

</main>
</Layout>
