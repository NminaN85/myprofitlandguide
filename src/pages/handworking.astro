---
import Layout from '../components/Layout.astro';
---
<Layout>

    <div class="content">
            <div class="card wecome-card">
                <h2>Select a Company</h2>
                <p>Click on any company below to calculate Production cost.</p>
            </div>

            <div class="card">
                <div class="cards-grid">






             <div class="company-card" onclick="location.href='/foundary'">
  <i class="fa-solid fa-industry" style="color:#e67e22"></i>
  Foundary
</div>

<div class="company-card" onclick="location.href='/milkfactory'">
  <i class="fa-solid fa-glass-water" style="color:#3498db"></i>
  Milk Factory
</div>

<div class="company-card" onclick="location.href='/cowfarm'">
  <i class="fa-solid fa-cow" style="color:#27ae60"></i>
  Cow Farm
</div>

<div class="company-card" onclick="location.href='/bakery'">
  <i class="fa-solid fa-bread-slice" style="color:#f1c40f"></i>
  Bakery
</div>

<div class="company-card" onclick="location.href='/homes'">
  <i class="fa-solid fa-house" style="color:#9b59b6"></i>
  House Constractions
</div>
<div class="company-card" onclick="location.href='/glassfactory'">
  <i class="fa-solid fa-house-window" style="color:#3498db"></i>
  Glass Factory
</div>



               
               
                </div>
            </div>
        </div>

</Layout>
